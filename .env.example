# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Supabase ---
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Publishable / anon key. Safe for the browser and used by the RLS-scoped
# auth middleware.
SUPABASE_PUBLISHABLE_KEY=
# Service role (secret) key. SERVER ONLY — bypasses RLS. Never expose to the
# client bundle. Required by src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot token encryption ---
# 32 random bytes, base64. Encrypts rows in public.bot_tokens.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored bot token unrecoverable (users re-paste).
# The runtime service needs the SAME value to decrypt tokens.
BOT_TOKEN_ENCRYPTION_KEY=

# --- Bot runtime service ---
# Base URL of the long-lived runtime process that owns the Discord gateway
# connections, e.g. https://runtime.internal.example.com (no trailing slash).
BOT_RUNTIME_URL=
# Secret this app sends TO the runtime (Authorization: Bearer ...) when starting
# or stopping a bot. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BOT_RUNTIME_SHARED_SECRET=
# Secret the runtime sends BACK to this app on /api/internal/* (token fetch and
# state reports). Use a DIFFERENT value from BOT_RUNTIME_SHARED_SECRET so one
# leak never grants both directions. Minimum 32 characters.
BOT_RUNTIME_CALLBACK_SECRET=

# Discord OAuth variables used by src/lib/discord.functions.ts and
# src/lib/discord-auth.functions.ts are appended in a follow-up commit once
# their exact names are confirmed against those modules.