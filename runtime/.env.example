# Bot runtime service configuration.
# Copy to runtime/.env and load it however you run the process
# (systemd EnvironmentFile, Docker --env-file, `node --env-file=.env dist/index.js`).

# ---------------------------------------------------------------------------
# HTTP API (control plane -> runtime)
# ---------------------------------------------------------------------------
BOT_RUNTIME_HOST=0.0.0.0
BOT_RUNTIME_PORT=8787

# Must equal BOT_RUNTIME_SHARED_SECRET in the web app. >= 32 chars.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BOT_RUNTIME_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Callbacks (runtime -> control plane)
# ---------------------------------------------------------------------------
# Origin of the web app, no trailing slash. Use https outside local dev.
CONTROL_PLANE_URL=https://your-app.example.com

# Must equal BOT_RUNTIME_CALLBACK_SECRET in the web app. >= 32 chars.
BOT_RUNTIME_CALLBACK_SECRET=

# ---------------------------------------------------------------------------
# Token decryption
# ---------------------------------------------------------------------------
# EXACTLY the same base64 32-byte key as the web app, or every token fails to
# decrypt. Rotating it invalidates all stored tokens.
BOT_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Guilds and GuildMessages are always requested. Add privileged intents here
# ONLY after enabling them in the Discord developer portal, or login fails with
# "Privileged intent provided is not enabled or whitelisted".
# Example: GuildMembers,MessageContent
DISCORD_EXTRA_INTENTS=

# Concurrent gateway connections this instance will hold.
MAX_CONCURRENT_BOTS=50

# debug | info | warn | error
BOT_RUNTIME_LOG_LEVEL=info