{
  "name": "bottly-bot-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Long-lived Discord gateway runtime for Bottly. Owns the bot connections; the web app is only its control plane.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "node --watch dist/index.js"
  },
  "dependencies": {
    "discord.js": "14.16.3"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "typescript": "5.8.3"
  }
}